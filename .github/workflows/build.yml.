name: Build Telegram Backup APK

on:
  push:
    branches: [ "main", "master" ]
  workflow_dispatch:

jobs:
  build-apk:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout Source Code
      uses: actions/checkout@v4

    - name: Set up JDK 17
      uses: actions/setup-java@v4
      with:
        distribution: 'temurin'
        java-version: '17'

    - name: Set up Android SDK
      uses: android-actions/setup-android@v3

    # تنزيل ملفات TDLib الجاهزة مباشرة
    - name: Download Pre-built TDLib & Java Bindings
      run: |
        mkdir -p app/src/main/jniLibs/arm64-v8a
        mkdir -p app/src/main/jniLibs/armeabi-v7a
        mkdir -p app/src/main/java/org/drinkless/tdlib

        curl -sL https://raw.githubusercontent.com/tdlib/td/master/example/java/org/drinkless/tdlib/Client.java -o app/src/main/java/org/drinkless/tdlib/Client.java
        curl -sL https://raw.githubusercontent.com/tdlib/td/master/example/java/org/drinkless/tdlib/TdApi.java -o app/src/main/java/org/drinkless/tdlib/TdApi.java

        curl -sL https://github.com/upx7/tdlib-android/releases/download/v1.8.0/arm64-v8a_libtdjni.so -o app/src/main/jniLibs/arm64-v8a/libtdjni.so
        curl -sL https://github.com/upx7/tdlib-android/releases/download/v1.8.0/armeabi-v7a_libtdjni.so -o app/src/main/jniLibs/armeabi-v7a/libtdjni.so

    - name: Inject Telegram Secrets
      run: |
        echo "TELEGRAM_API_ID=${{ secrets.TELEGRAM_API_ID }}" >> local.properties
        echo "TELEGRAM_API_HASH=${{ secrets.TELEGRAM_API_HASH }}" >> local.properties

    - name: Build Android Debug APK
      run: |
        gradle wrapper --gradle-version 8.4 --distribution-type bin
        chmod +x gradlew
        ./gradlew assembleDebug --stacktrace

    - name: Upload APK to Artifacts
      uses: actions/upload-artifact@v4
      with:
        name: Telegram-Backup-APK
        path: app/build/outputs/apk/debug/app-debug.apk
        retention-days: 7
